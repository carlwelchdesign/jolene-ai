{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jolene.local/public-career-evidence-v1.schema.json",
  "title": "Jolene Public Career Evidence Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "evidence"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "corpusVersion",
        "corpusHash",
        "generatedAt",
        "reviewedAt",
        "evidenceCount",
        "revokedEvidenceIds"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "corpusVersion": { "type": "string", "pattern": "^career:[a-f0-9]{64}$" },
        "corpusHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "revokedEvidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^career:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "claim", "citation"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^career:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "claim": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "text", "evidenceIds", "evidenceStrength", "maturity", "limitations"],
            "properties": {
              "claimId": { "type": "string", "format": "uuid" },
              "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "evidenceIds": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "pattern": "^career:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" } },
              "evidenceStrength": { "enum": ["strong", "moderate", "limited"] },
              "maturity": { "enum": ["not_applicable", "planning", "prototype", "development", "pre_release", "deployed_demo", "production", "released_product"] },
              "limitations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
            }
          },
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceId", "title", "href", "sourceType", "strength", "maturity", "lastReviewedAt"],
            "properties": {
              "evidenceId": { "type": "string", "pattern": "^career:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 240 },
              "href": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "sourceType": { "enum": ["resume", "employer_history", "recommendation", "project", "repository", "release_artifact", "portfolio_page", "confirmed_fact"] },
              "strength": { "enum": ["strong", "moderate", "limited"] },
              "maturity": { "enum": ["not_applicable", "planning", "prototype", "development", "pre_release", "deployed_demo", "production", "released_product"] },
              "lastReviewedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflictId", "evidenceIds", "status"],
        "properties": {
          "conflictId": { "type": "string", "pattern": "^conflict:[a-f0-9]{16}$" },
          "evidenceIds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^career:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
          },
          "status": { "const": "unresolved" }
        }
      }
    }
  }
}

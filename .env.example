OPENAI_API_KEY=
# Optional alternative to OPENAI_API_KEY; never configure both.
OPENAI_API_KEY_FILE=
JOLENE_MODEL=gpt-5.6-terra
# One-switch personality rollback for private, Slack, and public model answers.
JOLENE_PERSONALITY_MODE=jolene
JOLENE_HOST=127.0.0.1
JOLENE_PORT=8421
# Required high-entropy bearer for the private local control plane.
JOLENE_PRIVATE_CONTROL_TOKEN=
# Optional file alternative; never configure both forms.
JOLENE_PRIVATE_CONTROL_TOKEN_FILE=
JOLENE_DATABASE_PATH=.jolene/jolene.sqlite
JOLENE_OBSIDIAN_VAULT_ROOT=/absolute/path/to/your/Obsidian/vault
JOLENE_OBSIDIAN_ALLOWLIST=02 Projects,03 Engineering,06 Personal/Recipes and Cooking.md,06 Personal/Carl Welch Character Profile.md,07 Sources/Apple Notes
JOLENE_CAREER_OBSIDIAN_ALLOWLIST=01 Career & Job Search
JOLENE_CAREER_EMBEDDINGS_ENABLED=false
# Keep local_only unless private retrieved evidence is explicitly approved for OpenAI egress.
JOLENE_PRIVATE_RETRIEVAL_PROVIDER_EGRESS=local_only
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JOLENE_MAX_HISTORY_TURNS=16
JOLENE_MAX_MEMORY_ITEMS=24
JOLENE_PORTFOLIO_ROOT=../carl-welch-portfolio
JOLENE_OWNER_ACTOR_ID=carl
JOLENE_OWNER_WORKSPACE_ID=personal
JOLENE_CAREER_WORKSPACE_ID=professional
JOLENE_PUBLIC_CAREER_EXPORT_PATH=.jolene/exports/public-career-evidence.json
JOLENE_PUBLIC_CORPUS_REVIEW_PACKET_PATH=.jolene/evaluations/public-corpus-import-review.json
JOLENE_PUBLIC_LIVE_REVIEW_PACKET_PATH=.jolene/evaluations/public-live-model-review.json
JOLENE_PUBLIC_LIVE_REVIEW_DECISION_PATH=.jolene/evaluations/public-live-model-decision.json
JOLENE_PERSONALITY_RESEARCH_DECISION_PATH=.jolene/personality/research-decision.json
JOLENE_PERSONALITY_TUNING_DECISION_PATH=.jolene/personality/tuning-decision.json
JOLENE_WATCHED_PROJECTS=[]
JOLENE_PRIVATE_BRIEFING={"enabled":false,"destination":"slack_owner_dm","frequency":"daily","dayOfWeek":null,"localHour":8,"localMinute":0,"timeZone":"America/Los_Angeles","maxDeliveriesPerDay":1,"stopAfterDeliveries":365,"historyLimit":90,"maxAttempts":5}
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional file alternatives for host/container secret injection; never set both forms.
SLACK_BOT_TOKEN_FILE=
SLACK_APP_TOKEN_FILE=
SLACK_OWNER_USER_ID=
SLACK_OWNER_TEAM_ID=

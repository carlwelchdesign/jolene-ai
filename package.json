    "research:personality:selection:v5:generate": "tsx scripts/generate-personality-selection-ledgers-v5.ts",
    "research:personality:selection:v5:html-text": "tsx scripts/validate-personality-selected-html-source-text.ts",
    "research:personality:selection:v5:pdf-text": "node scripts/validate-personality-selected-pdf-source-text.mjs",
    "research:personality:primary-coding:v5:capture": "tsx scripts/capture-personality-primary-coding-v5.ts",
    "research:personality:primary-coding:v5": "tsx scripts/validate-personality-primary-coding-v5.ts",
    "research:personality:primary-coding:v5:rights": "tsx scripts/validate-personality-primary-coding-rights-v5.ts",
    "research:personality:independent-review:v5:capture": "tsx scripts/capture-personality-independent-review-v5.ts",
    "research:personality:independent-review:v5": "tsx scripts/validate-personality-independent-review-v5.ts",
    "research:personality:recoding:v1:capture": "tsx scripts/capture-personality-recoding-v1.ts",
    "research:personality:recoding:v1": "tsx scripts/validate-personality-recoding-v1.ts",
    "research:personality:admission-audit:v1:capture": "tsx scripts/capture-personality-admission-audit-v1.ts",
    "research:personality:admission-audit:v1": "tsx scripts/validate-personality-admission-audit-v1.ts",
    "research:personality:character-graph:v1:generate": "tsx scripts/generate-personality-character-graph-v1.ts",
    "research:personality:character-graph:v1": "tsx scripts/validate-personality-character-graph-v1.ts",
    "research:personality:runtime-admissions:v1": "tsx scripts/validate-runtime-personality-admissions-v1.ts",
    "research:personality:s03-duplicate-audit:v1": "tsx scripts/validate-personality-s03-duplicate-overlap-audit.ts",
    "research:personality:s03-duplicate-audit:v1:generate": "tsx scripts/generate-personality-s03-duplicate-overlap-audit.ts",
    "research:personality:s03-duplicate-amendment:v1": "tsx scripts/validate-personality-s03-duplicate-overlap-amendment.ts",
    "research:personality:s03-duplicate-amendment:v1:generate": "tsx scripts/generate-personality-s03-duplicate-overlap-amendment.ts",
    "research:personality:s03-unique-capacity:v1": "tsx scripts/validate-personality-s03-unique-capacity-view.ts",
    "research:personality:s03-unique-capacity:v1:generate": "tsx scripts/generate-personality-s03-unique-capacity-view.ts",
    "research:personality:capacity:v1": "tsx scripts/validate-personality-sampling-capacity-audit.ts",
    "research:personality:boundary-protocol:v1": "tsx scripts/validate-personality-sampling-boundary-protocol.ts",
    "research:personality:av-recovery:v1": "tsx scripts/validate-personality-av-recovery-outcome.ts",
    "research:personality:boundary-drafts:html": "tsx scripts/generate-personality-html-boundary-drafts.ts",
    "research:personality:html-ledger-fingerprints:v1": "tsx scripts/generate-personality-html-ledger-fingerprint-maps.ts",
    "research:personality:html-capacity-ledgers:v1": "tsx scripts/validate-personality-html-capacity-ledgers.ts",

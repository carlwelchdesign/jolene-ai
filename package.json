    "research:personality:capacity-manifest:generate": "tsx scripts/generate-personality-preallocation-capacity-manifest.ts",
    "research:personality:pdf-cue-audit:v1": "tsx scripts/validate-personality-pdf-cue-audit.ts",
    "research:personality:pdf-cue-amendment:v1": "tsx scripts/validate-personality-pdf-cue-amendment.ts",
    "research:personality:pdf-boundaries:v1": "tsx scripts/validate-personality-pdf-boundary-manifests.ts",
    "research:personality:pdf-ledger-fingerprints:v1": "tsx scripts/validate-personality-pdf-ledger-fingerprint-maps.ts",
    "research:personality:pdf-capacity-ledgers:v1": "tsx scripts/validate-personality-pdf-capacity-ledgers.ts",
    "security:prompt-injection:validate": "tsx scripts/validate-prompt-injection-threat-model.ts",
    "security:prompt-injection:red-team:validate": "tsx scripts/validate-prompt-injection-red-team-contract.ts",
    "security:operations:tabletop": "tsx scripts/run-security-tabletop.ts",
    "security:release:check": "tsx scripts/check-security-release.ts",
    "security:private-rag:validate": "tsx scripts/validate-private-rag-security.ts",
    "security:tool-authorization:validate": "tsx scripts/validate-tool-call-authorization.ts",
    "security:untrusted-content:validate": "tsx scripts/validate-untrusted-content-envelopes.ts",
    "secrets:migrate-compose": "tsx scripts/migrate-compose-secrets.ts",
    "slack": "tsx src/slack.ts",
    "start": "node dist/server.js",
    "start:career-index:lexical": "node dist/career-index.js",
    "start:career-relationships:audit": "node dist/career-topology.js",
    "start:career-export": "node dist/career-export.js",
    "start:public": "node dist/public-server.js",
    "start:public:preflight": "node dist/public-deployment-preflight.js",
    "start:monitor": "node dist/project-monitor.js",
    "start:mcp:career": "node dist/private-career-mcp.js",
    "start:slack": "node dist/slack.js",
    "pretest": "npm run runtime:check",
    "test": "vitest run",
    "pretest:security:red-team": "npm run runtime:check",
    "test:security:red-team": "vitest run tests/prompt-injection-red-team-contract.test.ts tests/prompt-injection-cross-channel.test.ts tests/private-rag-adversarial-evaluation.test.ts tests/public-answer-grounding-adversarial.test.ts tests/public-live-model-evaluation.test.ts --pool=threads --maxWorkers=2 --fileParallelism=false",
    "test:watch": "vitest",
    "pretypecheck": "npm run runtime:check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@openai/agents": "^0.17.0",
    "@openai/agents-openai": "^0.17.0",
    "@slack/bolt": "^5.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "openai": "^7.5.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.25",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

{
  "name": "jolene-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private, policy-gated personal chief-of-staff agent for Carl.",
  "engines": {
    "node": ">=22 <23"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22 <23",
      "onFail": "error"
    }
  },
  "scripts": {
    "runtime:check": "node scripts/verify-node-runtime.mjs",
    "prebuild": "npm run runtime:check",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "career:import-portfolio": "tsx scripts/import-portfolio-evidence.ts",
    "career:import-portfolio:audit": "tsx scripts/import-portfolio-evidence.ts --audit",
    "career:import-portfolio:review-packet": "tsx scripts/import-portfolio-evidence.ts --review-packet",
    "career:import-portfolio:apply-approved": "tsx scripts/import-portfolio-evidence.ts --apply-approved-packet",
    "career:import-obsidian": "tsx scripts/import-obsidian-career.ts",
    "career:index": "tsx scripts/index-career-evidence.ts",
    "career:index:lexical": "tsx src/career-index.ts",
    "career:relationships:audit": "docker compose --profile tools run --rm --build jolene-career-topology-audit",
    "career:export-public": "docker compose --profile tools run --rm --build jolene-career-export",
    "career:export-public:host": "tsx scripts/export-public-career-evidence.ts",
    "check": "npm run typecheck && npm test",
    "predev": "npm run runtime:check",
    "chat": "tsx src/cli.ts",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/server.ts",
    "predev:public": "npm run runtime:check",
    "dev:public": "tsx watch src/public-server.ts",
    "predev:monitor": "npm run runtime:check",
    "dev:monitor": "tsx watch src/project-monitor.ts",
    "eval:public": "tsx scripts/evaluate-public-delegate.ts",
    "eval:public:live": "tsx scripts/evaluate-public-live-model.ts",
    "eval:public:live:refresh": "tsx scripts/refresh-public-live-model-fixture.ts",
    "eval:public:live:preflight": "tsx scripts/preflight-public-live-model.ts",
    "eval:career:relationships": "tsx scripts/evaluate-career-relationships.ts",
    "eval:conversation:validate": "tsx scripts/validate-conversational-quality-suite.ts",
    "eval:conversation:capture": "tsx scripts/capture-conversational-quality.ts",
    "mcp:career:audit": "tsx scripts/inspect-private-career-mcp-audit.ts",
    "mcp:career:dev": "tsx src/private-career-mcp.ts",
    "research:personality:validate": "tsx scripts/validate-personality-research.ts",
